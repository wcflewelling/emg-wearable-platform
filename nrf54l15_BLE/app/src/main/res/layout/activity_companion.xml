<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ios_grouped_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.MyoSense.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="Activity" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp">

            <include layout="@layout/view_demo_banner" android:id="@+id/demoBanner" />

            <!-- Hero -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp">

                <View android:layout_width="200dp" android:layout_height="200dp"
                    android:background="@drawable/bg_circle" android:backgroundTint="@color/tint_red_10" />

                <View android:id="@+id/heroRing"
                    android:layout_width="170dp" android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:background="@drawable/ring_activity"
                    android:backgroundTint="@color/ios_red" />

                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:orientation="vertical"
                    android:gravity="center">
                    <ImageView android:id="@+id/heroIcon"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:src="@drawable/ic_resting" app:tint="@color/ios_red"
                        android:contentDescription="activity" />
                    <TextView android:id="@+id/heroLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Low" android:textColor="@color/ios_red"
                        android:textStyle="bold" android:textSize="22sp" android:layout_marginTop="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Activity" android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView android:id="@+id/heroDescription"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Resting — little to no muscle activity"
                android:textColor="@color/ios_secondary_label" android:textSize="14sp"
                android:gravity="center" android:layout_marginTop="16dp" android:paddingHorizontal="24dp" />

            <!-- Waveform card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.MyoSense.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Live Signal"
                            android:textColor="@color/ios_label" android:textStyle="bold" android:textSize="14sp" />
                        <TextView android:id="@+id/tvConnBadge"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Disconnected" android:textSize="11sp" android:textColor="@color/ios_red"
                            android:background="@drawable/bg_rounded_8" android:backgroundTint="@color/tint_red_10"
                            android:paddingHorizontal="9dp" android:paddingVertical="4dp" />
                    </LinearLayout>
                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chart"
                        android:layout_width="match_parent" android:layout_height="150dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Guidance card -->
            <androidx.cardview.widget.CardView
                style="@style/Widget.MyoSense.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="What to watch for" android:textColor="@color/ios_secondary_label"
                        android:textStyle="bold" android:textSize="12sp" android:layout_marginBottom="10dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_strong" app:tint="@color/ios_green" android:contentDescription="high" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="High — Strong activation" android:textColor="@color/ios_label" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Muscle is firing strongly. Good range for resistance work."
                                android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="14dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_light" app:tint="@color/ios_yellow" android:contentDescription="moderate" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Moderate — Light activation" android:textColor="@color/ios_label" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Partial activation. Typical of warm-up or light effort."
                                android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="14dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_resting" app:tint="@color/ios_blue" android:contentDescription="low" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Low — Resting" android:textColor="@color/ios_label" android:textStyle="bold" android:textSize="14sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Little to no muscle activity. Baseline state between efforts."
                                android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
