<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Session Tag (optional)" android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
    <EditText android:id="@+id/etTag"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="e.g. Left quad — warm-up"
        android:background="@drawable/bg_rounded_8" android:backgroundTint="@color/ios_system_fill"
        android:padding="10dp" android:textSize="15sp" android:singleLine="true"
        android:textColor="@color/ios_label" android:textColorHint="@color/ios_secondary_label"
        android:layout_marginTop="6dp" android:layout_marginBottom="14dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Notes (optional)" android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
    <EditText android:id="@+id/etNotes"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Notes"
        android:background="@drawable/bg_rounded_8" android:backgroundTint="@color/ios_system_fill"
        android:padding="10dp" android:textSize="15sp" android:singleLine="true"
        android:textColor="@color/ios_label" android:textColorHint="@color/ios_secondary_label"
        android:layout_marginTop="6dp" android:layout_marginBottom="14dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sensor Side" android:textColor="@color/ios_secondary_label" android:textSize="12sp"
        android:layout_marginBottom="6dp" />
    <RadioGroup android:id="@+id/rgSide"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton android:id="@+id/sideLeft" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Left" android:textColor="@color/ios_label" />
        <RadioButton android:id="@+id/sideBoth" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Both" android:checked="true" android:textColor="@color/ios_label" />
        <RadioButton android:id="@+id/sideRight" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Right" android:textColor="@color/ios_label" />
    </RadioGroup>
</LinearLayout>
