<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MyoSense.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_doc" android:contentDescription="file" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView android:id="@+id/tvName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/ios_label" android:textSize="14sp"
                android:maxLines="1" android:ellipsize="middle" tools:text="myosense_20260602.csv"
                xmlns:tools="http://schemas.android.com/tools" />
            <TextView android:id="@+id/tvMeta"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
        </LinearLayout>

        <ImageView android:id="@+id/btnShare"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_share" android:padding="8dp"
            app:tint="@color/ios_blue"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="share" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
