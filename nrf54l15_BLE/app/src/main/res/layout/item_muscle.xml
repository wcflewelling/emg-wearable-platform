<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.MyoSense.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <View android:id="@+id/groupDot"
            android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_circle" android:backgroundTint="@color/ios_blue" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:textColor="@color/ios_label"
                    android:textStyle="bold" android:textSize="15sp" />
                <TextView android:id="@+id/tvMuscle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/ios_secondary_label" android:textSize="12sp" />
            </LinearLayout>
            <TextView android:id="@+id/tvDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="@color/ios_secondary_label" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
