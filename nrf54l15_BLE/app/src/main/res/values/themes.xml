<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- iOS-style light theme. Forced light (the iOS app ships light only). -->
    <style name="Theme.MyoSense" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorPrimaryVariant">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/myo_teal</item>
        <item name="colorSecondaryVariant">@color/sense_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/ios_grouped_background</item>
        <item name="colorSurface">@color/ios_secondary_background</item>
        <item name="android:windowBackground">@color/ios_grouped_background</item>
        <item name="android:statusBarColor">@color/ios_grouped_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/ios_secondary_background</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog</item>
    </style>

    <!-- Toolbar that reads like an iOS large/inline nav bar. -->
    <style name="Widget.MyoSense.Toolbar" parent="Widget.MaterialComponents.Toolbar.Surface">
        <item name="android:background">@color/ios_grouped_background</item>
        <item name="titleTextColor">@color/ios_label</item>
        <item name="titleTextAppearance">@style/TextAppearance.MyoSense.Toolbar</item>
    </style>

    <style name="TextAppearance.MyoSense.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Filled, rounded iOS-style primary button. -->
    <style name="Widget.MyoSense.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Widget.MyoSense.Button.Tonal" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card used everywhere as the iOS "secondarySystemBackground" surface. -->
    <style name="Widget.MyoSense.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/ios_secondary_background</item>
        <item name="strokeColor">@color/ios_separator</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- iOS-style grouped settings rows. -->
    <style name="SettingsHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:textColor">@color/ios_secondary_label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="SettingsRowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ios_label</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsRowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ios_secondary_label</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginHorizontal">14dp</item>
        <item name="android:background">@color/ios_separator</item>
    </style>
</resources>
