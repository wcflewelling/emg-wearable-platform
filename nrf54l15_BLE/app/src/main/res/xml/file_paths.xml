<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider paths for sharing CSV exports via Intent.ACTION_SEND.
  external-files-path maps to getExternalFilesDir(null) where CSVs are saved.
  If external storage is unavailable the code falls back to getFilesDir() (files-path).
-->
<paths>
    <external-files-path name="csv_exports" path="." />
    <files-path          name="csv_exports_internal" path="." />
</paths>
